; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HappyBirthdayLena"
run/main_scene="uid://cf5y77c0aowei"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SceneTransition="*res://assets/scripts/scene_transition.gd"
GameSettings="*res://assets/scripts/game_settings.gd"
DialogueManager="*uid://c3rodes2l3gxb"
InputBindings="*res://assets/scripts/input_bindings.gd"
AudioService="*res://assets/scripts/audio_service.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/assetplus/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/proximity_prompt/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://assets/dialogue/test_npc.dialogue", "res://assets/dialogue/friend_intro_template.dialogue", "res://assets/dialogue/templates/who_are_you_loop_break_template.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
