[sub_resource type="Shader" id="Shader_wd4u4"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, fog_disabled;

uniform vec4 top_color : source_color = vec4(0.39, 0.74, 0.96, 1.0);
uniform vec4 horizon_color : source_color = vec4(0.58, 0.82, 0.98, 1.0);
uniform float horizon_height = 0.18;
uniform float horizon_softness = 0.18;

void fragment() {
	float t = smoothstep(horizon_height, horizon_height + horizon_softness, UV.y);
	ALBEDO = mix(horizon_color.rgb, top_color.rgb, t);
	ALPHA = 1.0;
}
"

